generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Money is stored as integer cents, quantity as hundredths and tax as basis
// points so no floating-point value ever touches a calculation.
// Totals are derived (see src/lib/totals.ts), never stored.
model Invoice {
  id              String   @id @default(cuid())
  number          String   @unique
  issueDate       String // YYYY-MM-DD, date-only to avoid timezone drift
  dueDate         String
  businessName    String
  businessEmail   String   @default("")
  businessAddress String   @default("")
  customerName    String
  customerEmail   String   @default("")
  customerAddress String   @default("")
  notes           String   @default("")
  discountCents   Int      @default(0)
  taxRateBps      Int      @default(0) // 10% = 1000
  lastSentAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems    LineItem[]
  customFields CustomField[]
}

model LineItem {
  id                 String  @id @default(cuid())
  invoiceId          String
  invoice            Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position           Int
  description        String
  quantityHundredths Int // 1.5 = 150
  unitPriceCents     Int

  @@index([invoiceId])
}

model CustomField {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int
  label     String
  value     String
  visible   Boolean @default(true)

  @@index([invoiceId])
}
