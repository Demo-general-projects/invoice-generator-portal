node_modules/
.next/
dist/
coverage/
*.tsbuildinfo

# secrets and local data
.env
.env*.local
!.env.example
*.db
*.db-journal
*.pem

# OS / tooling noise
.DS_Store
npm-debug.log*

# private materials, never published
/customizable-invoice-generator-interview-exercise.pdf
