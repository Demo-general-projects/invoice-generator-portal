# Each app (frontend/, backend/) has its own .gitignore; these apply repo-wide.

# dependencies and build output, in any folder
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo

# local data (.env files are committed so a fresh clone runs as-is; they hold no real secrets)
.env*.local
*.db
*.db-journal
*.pem

# OS / tooling noise
.DS_Store
npm-debug.log*

# private materials, never published
/customizable-invoice-generator-interview-exercise.pdf
