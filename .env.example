# SQLite file, relative to the prisma/ folder's parent (project root)
DATABASE_URL="file:./dev.db"

# Public base URL used for the "View invoice" link in emails
APP_URL="http://localhost:3000"

# SMTP (any provider). Example for Resend SMTP: host smtp.resend.com, port 465, user "resend", pass = API key
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Sender shown to recipients, must be allowed by your provider
EMAIL_FROM="Invoices <invoices@example.com>"
