# SQLite database file. Locally: file:./dev.db
# On a host, point this at the persistent disk, e.g. file:/data/ledgerline.db
DATABASE_URL="file:./dev.db"

# Port to listen on. Most hosts set PORT for you; API_PORT is the local fallback.
API_PORT="4000"

# Public URL of the frontend, used for the "View invoice online" link in emails
APP_URL="http://localhost:3000"

# SMTP (any provider). Resend: host smtp.resend.com, port 465, user "resend", pass = API key
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Sender shown to recipients: "Name <address>" (a bare name is rejected).
# With Resend and no verified domain use: Acme Studio <onboarding@resend.dev>
EMAIL_FROM="Invoices <invoices@example.com>"
