APP_NAME=Ledgerline
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Where this Laravel app runs. The built frontend is served from APP_URL/app.
APP_URL=http://localhost:8000
# Optional: where the invoice app is opened from, for the link in emails.
# Defaults to APP_URL/app. While running the Next.js dev server use http://localhost:3000/app
# FRONTEND_URL=http://localhost:3000/app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite. Without DB_DATABASE the file is database/database.sqlite.
# On a host, point it at a persistent disk, e.g. DB_DATABASE=/data/ledgerline.sqlite
DB_CONNECTION=sqlite
# DB_DATABASE=

# The API is stateless: no sessions, queues or cache tables are needed.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Email over SMTP (any provider). Until MAIL_MAILER=smtp is set, sending returns a clear 503.
# Resend: host smtp.resend.com, port 465, scheme smtps, username "resend", password = API key.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# With Resend and no verified domain use onboarding@resend.dev
MAIL_FROM_ADDRESS="invoices@example.com"
MAIL_FROM_NAME="Acme Studio"
